<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>@ViewData["Title"] - Cyber Cougars</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="bar">
        <div class="wrap">
            <button type="button" class="icon-btn" id="menuToggle"
                    aria-label="Open menu" aria-controls="siteMenu" aria-expanded="false">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18" /></svg>
            </button>

            <a class="brand" href="/Products" aria-label="Cyber Cougars, go to products">
                <img class="brand-logo" src="~/Images/CyberCougarsCircleLogo.png" asp-append-version="true" alt="cyber cougars logo" />
                    <circle cx="20" cy="20" r="18" fill="#272324" stroke="#82142c" stroke-width="3" />
                <span>Cyber Cougars</span>
            </a>

            <form class="search" role="search" method="get" action="/Products/Search">
                <input type="search" name="q" placeholder="Search merch and events" aria-label="Search" />
            </form>

            @* Account (CAR-68): "Log in" when signed out; first name and "Log out" when signed in.
               Log out is a POST form (with the anti-forgery token) so another site can't sign people out. *@
            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="account-nav">
                    <span class="account-greeting">Hi, @User.Identity.Name</span>
                    <form method="post" asp-page="/Account/Logout" class="account-logout">
                        <button type="submit" class="account-nav-link">Log out</button>
                    </form>
                </div>
            }
            else
            {
                <a class="account-nav-link" asp-page="/Account/Login"
                   asp-route-returnUrl="@(Context.Request.Path.StartsWithSegments("/Account") ? null : Context.Request.Path + Context.Request.QueryString)">Log in</a>
            }
        </div>
    </header>

    <div class="scrim" id="menuScrim" hidden></div>
    <aside class="drawer" id="siteMenu" aria-label="Menu" hidden>
        <div class="drawer-head">
            <h2>Menu</h2>
            <button type="button" class="icon-btn" id="menuClose" aria-label="Close menu">&times;</button>
        </div>
        <nav class="navlinks">
            <a href="/Products">Merch</a>
            <a href="/Events">Events</a>
            <a href="/Officer/Products/Index">Product dashboard</a>
            <a href="/Officer/Events/Create">Create event</a>
            <a href="/Officer/Venues/Create">Add venue</a>
        </nav>
    </aside>

    <main class="wrap" role="main">
        @RenderBody()
    </main>

    <footer class="site">
        <div class="wrap">
            <div class="foot-brand">
                <div class="brand brand-dark">Cyber Cougars</div>
                <p class="note">Merch and events for the club.</p>
            </div>
            <div class="cols">
                <div>
                    <h4>Shop</h4>
                    <a href="/Products/Index">Merch</a>
                </div>
                <div>
                    <h4>Club</h4>
                    <a href="/Events/Index">Events</a>
                </div>
                <div>
                    <h4>Officers</h4>
                    <a href="/Officer/Products/Index">Product dashboard</a>
                    <a href="/Officer/Events/Create">Create event</a>
                    <a href="/Officer/Venues/Create">Add venue</a>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
