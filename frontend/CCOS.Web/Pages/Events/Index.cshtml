@page
@model IndexModel
@using System.Globalization
@{
    ViewData["Title"] = "Events";
}

<link rel="stylesheet" href="~/css/events.css" asp-append-version="true" />

@if (TempData["VenueAdded"] is string venueAdded)
{
    <p class="events-message" role="status">@venueAdded</p>
}
@if (TempData["EventAdded"] is string eventAdded)
{
    <p class="events-message" role="status">@eventAdded</p>
}
@if (TempData["EventRemoved"] is string eventRemoved)
{
    <p class="events-message" role="status">@eventRemoved</p>
}
@if (TempData["EventError"] is string eventError)
{
    <p class="events-message" role="alert">@eventError</p>
}

<section class="events-hero">
    <img class="events-hero-logo" src="~/Images/CyberCougarsCircleLogo.png" asp-append-version="true" alt="Cyber Cougars logo" />
    <div>
        <h1>Cyber Cougars Events</h1>
        <p>Join us!</p>
    </div>
</section>

<section class="events-section" aria-labelledby="upcoming-heading">
    <div class="events-section-head">
        <h2 id="upcoming-heading">
            Upcoming events
            @if (Model.UpcomingEvents.Count > 0)
            {
                <span class="events-count">@Model.UpcomingEvents.Count upcoming</span>
            }
        </h2>

        @* Officer actions: only shown to officers (CAR-69). The Officer pages and the API check on their own too. *@
        @if (User.IsOfficer())
        {
        <details class="events-options" id="eventOptions">
            <summary aria-label="Event options">
                <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="5" r="2" /><circle cx="12" cy="12" r="2" /><circle cx="12" cy="19" r="2" /></svg>
            </summary>
            <div class="events-options-menu">
                <a asp-page="/Officer/Events/Create">Create an event</a>
                <a asp-page="/Officer/Events/Index">Manage events</a>
                <a asp-page="/Officer/Venues/Create">Add a venue</a>
                <a asp-page="/Officer/Venues/Index">Manage venues</a>
            </div>
        </details>
        }
    </div>

    @if (Model.LoadFailed)
    {
        <p class="events-empty" role="alert">Events couldn't be loaded right now. Please try again later.</p>
    }
    else if (Model.UpcomingEvents.Count == 0)
    {
        <p class="events-empty">No upcoming events</p>
    }
    else
    {
        <ul class="events-grid">
            @foreach (var ev in Model.UpcomingEvents)
            {
                var starts = ClubTime.ToClubTime(ev.StartsAtUtc);
                var prices = TicketPrices.ForEvent(ev);
                @* Revamped in CAR-76 from Jason's Sprint 4 review notes: date block, time, venue,
                   members-only tag, one line of the description, and the price at the bottom. *@
                <li>
                    <a class="events-card" asp-page="/Events/Details" asp-route-id="@ev.EventId">
                        <div class="events-card-when">
                            <span class="events-card-calendar">
                                <span class="events-card-month">@starts.ToString("MMM", CultureInfo.InvariantCulture)</span>
                                <span class="events-card-day">@starts.Day</span>
                            </span>
                            <span class="events-card-weekday">@starts.ToString("dddd", CultureInfo.InvariantCulture)</span>
                        </div>
                        <div class="events-card-body">
                            @if (ev.MembersOnly)
                            {
                                <span class="events-card-tag">Members only</span>
                            }
                            <span class="events-card-title">@ev.Name</span>
                            <span class="events-card-meta">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg>
                                @ClubTime.FormatTimeRange(ev.StartsAtUtc, ev.EndsAtUtc)
                            </span>
                            <span class="events-card-meta">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11z" /><circle cx="12" cy="10" r="2.5" /></svg>
                                @ev.VenueName
                            </span>
                            @if (!string.IsNullOrWhiteSpace(ev.Description))
                            {
                                <span class="events-card-summary">@ev.Description</span>
                            }
                            <span class="events-card-foot">
                                @if (!prices.IsEmpty)
                                {
                                    <partial name="_PriceTag" model="prices" />
                                }
                                else if (TicketPrices.MemberPriceHidden(ev))
                                {
                                    @* Members-only, and the visitor isn't a current member (CAR-69). *@
                                    <span class="events-card-price-note">Log in as a member to see the price</span>
                                }
                                else
                                {
                                    <span class="events-card-price-note">Tickets aren't on sale yet</span>
                                }
                            </span>
                        </div>
                    </a>
                </li>
            }
        </ul>
    }
</section>

<section class="events-section" aria-labelledby="news-heading">
    <div class="events-section-head">
        <h2 id="news-heading">News:</h2>
    </div>

    @if (Model.News.Count == 0)
    {
        <p class="events-empty">Stay tuned for updates!</p>
    }
    else
    {
        <ul class="events-grid">
            @foreach (var item in Model.News)
            {
                <li>
                    <article class="events-card">
                        <div class="events-card-image" aria-hidden="true">
                            <svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="16" rx="2" /><path d="M7 9h10M7 13h10M7 17h6" /></svg>
                        </div>
                        <div class="events-card-body">
                            <h3 class="events-card-title">@item.Title</h3>
                            <span class="events-card-text">@item.Summary</span>
                        </div>
                    </article>
                </li>
            }
        </ul>
    }
</section>

@section Scripts {
    <script>
        // Close the event options menu on an outside click or Escape.
        (function () {
            var options = document.getElementById('eventOptions');
            if (!options) return;
            document.addEventListener('click', function (e) {
                if (options.open && !options.contains(e.target)) options.open = false;
            });
            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape' && options.open) {
                    options.open = false;
                    options.querySelector('summary').focus();
                }
            });
        })();
    </script>
}
