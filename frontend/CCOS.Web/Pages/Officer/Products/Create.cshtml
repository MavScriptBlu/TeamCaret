@page
@model CreateModel
@{
    ViewData["Title"] = "New Product";
}

<link rel="stylesheet" href="~/css/events.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/products.css" asp-append-version="true" />

<section class="product-create-page" aria-labelledby="product-create-title">
    <h1 id="product-create-title" class="event-form-title">Create Product</h1>

    <form method="post" class="event-form product-create-form">
        <div asp-validation-summary="ModelOnly"
             class="product-validation-summary"
             role="alert"></div>

        <div class="product-create-grid">
            <div class="product-create-images" aria-label="Product images">
                <label class="event-form-image product-image-drop product-image-drop-large"
                       data-image-drop>
                    <input class="event-form-file"
                           type="file"
                           accept="image/*"
                           aria-label="Choose primary product image"
                           data-image-input />
                    <img class="product-image-preview"
                         data-image-preview
                         alt=""
                         hidden />
                    <svg viewBox="0 0 24 24" aria-hidden="true" data-image-placeholder>
                        <rect x="3" y="3" width="18" height="18" rx="2" />
                        <circle cx="8.5" cy="8.5" r="1.5" />
                        <path d="m21 15-5-5L5 21" />
                    </svg>
                    <span data-image-status aria-live="polite">Image 1 — click or drop an image</span>
                </label>

                <div class="product-create-image-thumbnails">
                    <label class="event-form-image product-image-drop product-image-drop-small"
                           data-image-drop>
                        <input class="event-form-file"
                               type="file"
                               accept="image/*"
                               aria-label="Choose second product image"
                               data-image-input />
                        <img class="product-image-preview"
                             data-image-preview
                             alt=""
                             hidden />
                        <svg viewBox="0 0 24 24" aria-hidden="true" data-image-placeholder>
                            <rect x="3" y="3" width="18" height="18" rx="2" />
                            <circle cx="8.5" cy="8.5" r="1.5" />
                            <path d="m21 15-5-5L5 21" />
                        </svg>
                        <span data-image-status aria-live="polite">Image 2 — click or drop</span>
                    </label>

                    <label class="event-form-image product-image-drop product-image-drop-small"
                           data-image-drop>
                        <input class="event-form-file"
                               type="file"
                               accept="image/*"
                               aria-label="Choose third product image"
                               data-image-input />
                        <img class="product-image-preview"
                             data-image-preview
                             alt=""
                             hidden />
                        <svg viewBox="0 0 24 24" aria-hidden="true" data-image-placeholder>
                            <rect x="3" y="3" width="18" height="18" rx="2" />
                            <circle cx="8.5" cy="8.5" r="1.5" />
                            <path d="m21 15-5-5L5 21" />
                        </svg>
                        <span data-image-status aria-live="polite">Image 3 — click or drop</span>
                    </label>
                </div>
            </div>

            <div class="event-form-fields product-create-fields">
                <div class="product-form-field product-form-name-field">
                    <label class="visually-hidden" asp-for="Input.Name"></label>
                    <input asp-for="Input.Name"
                           class="event-form-name"
                           maxlength="100"
                           autocomplete="off"
                           placeholder="Product Name" />
                    <span asp-validation-for="Input.Name" class="field-validation-error"></span>
                </div>

                <div class="product-create-prices">
                    <div class="product-form-field">
                        <label asp-for="Input.Price"></label>
                        <input asp-for="Input.Price"
                               type="number"
                               min="0"
                               max="99999999.99"
                               step="0.01"
                               inputmode="decimal" />
                        <span asp-validation-for="Input.Price" class="field-validation-error"></span>
                    </div>

                    <div class="product-form-field">
                        <label asp-for="Input.MemberPrice"></label>
                        <input asp-for="Input.MemberPrice"
                               type="number"
                               min="0"
                               max="99999999.99"
                               step="0.01"
                               inputmode="decimal" />
                        <span asp-validation-for="Input.MemberPrice" class="field-validation-error"></span>
                    </div>
                </div>

                <div class="product-form-field">
                    <label asp-for="Input.StockQuantity"></label>
                    <input asp-for="Input.StockQuantity"
                           type="number"
                           min="0"
                           max="2147483647"
                           step="1" />
                    <span asp-validation-for="Input.StockQuantity" class="field-validation-error"></span>
                </div>

                <div class="product-form-field">
                    <label asp-for="Input.Description">Description (optional)</label>
                    <textarea asp-for="Input.Description" rows="5" maxlength="500"></textarea>
                    <span asp-validation-for="Input.Description" class="field-validation-error"></span>
                </div>

                <div class="product-form-field">
                    <label asp-for="Input.Category"></label>
                    <input asp-for="Input.Category" maxlength="30" autocomplete="off" />
                    <span asp-validation-for="Input.Category" class="field-validation-error"></span>
                </div>

                <div class="event-form-actions product-form-actions">
                    <button type="submit" class="event-rsvp product-form-save">Save</button>
                    <a asp-page="/Officer/Products/Index"
                       class="event-form-cancel product-form-cancel">Cancel</a>
                </div>
            </div>
        </div>
    </form>
</section>

@section Scripts {
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/product-create.js" asp-append-version="true"></script>
}