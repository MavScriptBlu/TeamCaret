@page
@model IndexModel
@using CCOS.Web.Services
@{
    ViewData["Title"] = "Officer Dashboard";
    var createdMessage = TempData["ProductCreated"] as string;
    var savedMessage = TempData["ProductSaved"] as string;
    var deactivatedMessage = TempData["ProductDeactivated"] as string;
    var deleteError = TempData["ProductDeleteError"] as string;
    var productMessage = deactivatedMessage ?? savedMessage ?? createdMessage;
}

<link rel="stylesheet" href="~/css/products.css" asp-append-version="true" />

@if (productMessage is not null)
{
    <p class="product-created-message" role="status">@productMessage</p>
}
@if (deleteError is not null)
{
    <p class="products-empty" role="alert">@deleteError</p>
}

@* Matches Wireframe-Officer-Edit and Wireframe-SoftDelete-IsActive (assets/Wireframes-Product). *@

<div class="officer-head">
    <h1>Officer Dashboard</h1>
    <div class="officer-actions">
        <a class="officer-pill" asp-page="/Officer/Products/Create">Create product</a>
        <form method="get" class="officer-filter">
            <select name="show" aria-label="Filter products" onchange="this.form.submit()">
                <option value="">All products</option>
                <option value="active" selected="@(Model.Show == "active")">Active</option>
                <option value="inactive" selected="@(Model.Show == "inactive")">Inactive</option>
            </select>
            <noscript><button type="submit">Apply</button></noscript>
        </form>
    </div>
</div>

@if (Model.LoadFailed)
{
    <p class="products-empty" role="alert">Products couldn't be loaded right now. Please try again later.</p>
}
else if (Model.TotalCount == 0)
{
    <p class="products-empty">No products yet. Use Create product to add one.</p>
}
else if (Model.Products.Count == 0)
{
    <div class="products-empty">
        <p>No products match this filter.</p>
        <a asp-page="/Officer/Products/Index">Show all products</a>
    </div>
}
else
{
    <ul class="officer-products">
        @for (var i = 0; i < Model.Products.Count; i++)
        {
            var product = Model.Products[i];
            <li>
                <details class="officer-product @(product.IsActive ? "" : "is-inactive")"
                          open="@(Model.ExpandedId == product.ProductId || (Model.ExpandedId is null && i == 0))">
                    <summary>
                        <span class="officer-product-name">@product.Name</span>
                        @if (!product.IsActive)
                        {
                            <span class="officer-badge">Deactivated</span>
                        }
                        else if (product.StockQuantity == 0)
                        {
                            <span class="officer-badge is-stock">Out of stock</span>
                        }
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg>
                    </summary>

                    <div class="officer-product-body">
                        <div class="officer-product-image" aria-hidden="true">
                            <svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2" /><circle cx="8.5" cy="8.5" r="1.5" /><path d="m21 15-5-5L5 21" /></svg>
                        </div>

                        <div class="officer-product-details">
                            @if (!product.IsActive)
                            {
                                <p class="officer-deactivated">Product Currently Deactivated</p>
                            }
                            <dl class="officer-facts">
                                <div><dt>Name</dt><dd>@product.Name</dd></div>
                                <div><dt>Price</dt><dd>@Money.Format(product.Price)</dd></div>
                                <div><dt>Member Price</dt><dd>@(product.MemberPrice is decimal memberPrice ? Money.Format(memberPrice) : "–")</dd></div>
                                <div><dt>Current stock</dt><dd>@product.StockQuantity</dd></div>
                                <div><dt>Category</dt><dd>@product.Category</dd></div>
                                <div><dt>IsActive</dt><dd>@(product.IsActive ? "Yes" : "No")</dd></div>
                            </dl>
                            <div class="officer-description">
                                <h2>Description</h2>
                                <p>@(string.IsNullOrWhiteSpace(product.Description) ? "No description." : product.Description)</p>
                            </div>
                        </div>
                    </div>

                    <div class="officer-product-actions">
						@if (product.IsActive)
						{
                            <form method="post"
                                  asp-page-handler="Delete"
                                  asp-route-id="@product.ProductId"
                                  asp-route-show="@Model.Show"
                                  class="officer-delete-form"
                                  data-delete-form>
                                <button type="button"
                                        class="officer-delete"
                                        data-delete-button
                                        data-product-name="@product.Name"
                                        aria-haspopup="dialog"
                                        aria-controls="deleteProductDialog">
                                    Delete Product
                                </button>
                            </form>
						}
                        <span class="officer-product-links">
                            @* Quick Edit remains a placeholder. *@
                            <button type="button" class="officer-pill">Quick Edit</button>
                            <a class="officer-pill" asp-page="/Officer/Products/Edit" asp-route-id="@product.ProductId">Edit product page</a>
                        </span>
                    </div>
                </details>
            </li>
        }
    </ul>
}

<dialog id="deleteProductDialog" class="officer-delete-dialog" aria-modal="true" aria-labelledby="deleteProductTitle" aria-describedby="deleteProductMessage">
    <h2 id="deleteProductTitle">Deactivate product?</h2>

    <p id="deleteProductMessage">
        Are you sure you want to deactivate <strong id="deleteProductName">this product</strong>?
        It will no longer appear on the public Products page. Existing order history is kept,
        and you can reactivate it from Edit.
    </p>

    <div class="officer-delete-dialog-actions">

        <button type="button" class="officer-delete" id="confirmProductDelete">
            Yes, deactivate
        </button>
        <button type="button" class="officer-pill" id="cancelProductDelete" autofocus>
            No
        </button>

    </div>
</dialog>

@section Scripts {
    <script src="~/js/officer-product-delete.js" asp-append-version="true"></script>
}
