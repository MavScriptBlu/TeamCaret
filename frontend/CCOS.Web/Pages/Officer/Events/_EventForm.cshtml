@model CCOS.Web.Pages.Officer.Events.EventFormPageModel
@*
    Shared form for Create Event and Edit Event. Matches Wireframe-Create-Event and
    Wirframe-Event-Edit, plus the event fields from the backlog and schema doc
    (capacity, members only, member price). The server checks every field and shows its message
    under the field (CAR-55). The Edit page also shows a "Show in the event list" box (CAR-56).
*@

<h1 class="event-form-title">@Model.Heading</h1>

<form method="post" class="event-form" novalidate>
    <div asp-validation-summary="ModelOnly" class="venue-validation-summary" role="alert"></div>
    <div class="event-detail-top">
        @* Image isn't in the database yet; the file is not uploaded or saved. *@
        <partial name="_ImageDrop" model="Model.ImagePrompt" />

        <div class="event-form-fields">
            <label class="visually-hidden" for="Name">Event name</label>
            <input asp-for="Name" class="event-form-name" placeholder="Event Name" maxlength="100" autocomplete="off" />
            <span asp-validation-for="Name" class="field-validation-error"></span>

            <div class="event-form-row">
                <span class="event-form-label" id="dateLabel">Date</span>
                <div class="event-form-inline" role="group" aria-labelledby="dateLabel">
                    <input asp-for="Date" type="date" asp-format="{0:yyyy-MM-dd}" aria-label="Date" />
                    <span class="event-form-times">
                        <input asp-for="StartTime" type="time" asp-format="{0:HH:mm}" aria-label="Start time" />
                        <span aria-hidden="true">–</span>
                        <input asp-for="EndTime" type="time" asp-format="{0:HH:mm}" aria-label="End time" />
                    </span>
                    <span asp-validation-for="Date" class="field-validation-error"></span>
                    <span asp-validation-for="StartTime" class="field-validation-error"></span>
                    <span asp-validation-for="EndTime" class="field-validation-error"></span>
                </div>
            </div>

            <div class="event-form-row">
                <label class="event-form-label" asp-for="VenueId">Location/Venue</label>
                <div class="event-form-stack">
                    <select asp-for="VenueId" asp-items="Model.VenueOptions">
                        <option value="">Choose a venue</option>
                    </select>
                    <span asp-validation-for="VenueId" class="field-validation-error"></span>
                    <a class="event-form-link" asp-page="/Officer/Venues/Create">Add a venue</a>
                </div>
            </div>

            <div class="event-form-row">
                <label class="event-form-label" asp-for="Category">Categories</label>
                <select asp-for="Category" asp-items="Model.CategoryOptions">
                    <option value="">Choose a category</option>
                </select>
            </div>

            <div class="event-form-row">
                <label class="event-form-label" asp-for="TicketCapacity">Capacity</label>
                <input asp-for="TicketCapacity" type="number" min="1" step="1" class="event-form-short" />
                <span asp-validation-for="TicketCapacity" class="field-validation-error"></span>
            </div>

            <div class="event-form-row">
                <span class="event-form-label"></span>
                <label class="event-form-check">
                    <input asp-for="MembersOnly" />
                    Members only
                </label>
            </div>

            <div class="event-form-prices">
                <label>
                    Ticket price
                    <span class="event-form-money"><span aria-hidden="true">$</span><input asp-for="TicketPrice" type="number" min="0" step="0.01" asp-format="{0:0.00}" /></span>
                </label>
                <label>
                    Member price
                    <span class="event-form-money"><span aria-hidden="true">$</span><input asp-for="MemberPrice" type="number" min="0" step="0.01" asp-format="{0:0.00}" /></span>
                </label>
            </div>

            <span asp-validation-for="TicketPrice" class="field-validation-error"></span>
            <span asp-validation-for="MemberPrice" class="field-validation-error"></span>

            @if (Model.ShowActiveBox)
            {
                <div class="event-form-row">
                    <span class="event-form-label"></span>
                    <div class="event-form-stack">
                        <label class="event-form-check">
                            <input asp-for="IsActive" />
                            Show in the event list
                        </label>
                        <span class="event-form-hint">Untick to remove this event. Tick to restore it. Nothing is deleted.</span>
                    </div>
                </div>
            }

            <div class="event-form-actions">
                <button type="submit" class="event-rsvp">@Model.SaveText</button>
                <a class="event-form-cancel" asp-page="@Model.CancelPage" asp-route-id="@Model.CancelRouteId">Cancel</a>
            </div>
        </div>
    </div>

    <div class="event-detail-description">
        <label class="visually-hidden" for="Description">Description</label>
        <textarea asp-for="Description" class="event-form-description" rows="5" maxlength="500" placeholder="Description and further details" aria-describedby="DescriptionHint"></textarea>
        @* The Events list shows one line of the description on each card (CAR-76). *@
        <p class="event-form-hint" id="DescriptionHint">The first line shows on the event card, so start with a one-sentence summary.</p>
        <span asp-validation-for="Description" class="field-validation-error"></span>
    </div>
</form>

