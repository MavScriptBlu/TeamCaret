# Copy this file, rename the copy to .env, and fill in your real values.
# This example file is safe to push to GitHub. The real .env is NOT.

# Shared dev settings for the PostgreSQL container. Everyone on the team can keep these
# exactly as they are: copy this file to .env once and you never type a password again.
# The password only protects a database on your own computer, so it's fine to share.
# Want your own? Change it in your .env BEFORE the first `task db`. Changed it later?
# Run `task reset` (it wipes local data) or Postgres keeps the old one.
POSTGRES_USER=ccos-db
POSTGRES_PASSWORD=ccos123
POSTGRES_DB=postgres
POSTGRES_PORT=5432

# Password for the sample logins (officer@ccos.test, member@ccos.test, guest@ccos.test) when the
# API runs in Docker. Pick one with the team and put it in your .env, not here. Leave it empty and
# the sample logins are skipped. For `dotnet run`, use the user secret in backend/README.md instead.
SAMPLE_ACCOUNT_PASSWORD=

# Only for `task` shortcuts. Leave it commented for Docker, uncomment for Podman.
# CONTAINER=podman

# Ports on your computer: website 8080, API 8081, database 5432 (POSTGRES_PORT above).
# Only uncomment if something else is already using them.
# WEB_PORT=8080
# API_PORT=8081
